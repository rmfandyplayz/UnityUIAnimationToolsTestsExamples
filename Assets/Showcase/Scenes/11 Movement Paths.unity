  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Demonstrations for the wiki page <b>Movement Paths</b>. Curved and Linear
    paths, a reusable Current-mode hop, and the path editor.\n\nEach frame is 960
    x 540 (16:9). In play mode the board starts focused on frame 1: Tab moves to
    the next, number keys jump, Home shows them all, H shows the index. With a frame
    focused, <b>Space</b> plays its demonstration, <b>R</b> puts it back and <b>L</b>
    loops it - set the Game view to 16:9 and the frame fills it exactly. \n\nSelect
    a frame to see in its Inspector what to capture and where it goes on the page.
    Assets/Showcase/SHOTLIST.md lists every shot."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f44eed8c3b5782c408b32755e14054d5, type: 2}

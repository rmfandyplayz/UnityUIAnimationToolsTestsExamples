  m_Script: {fileID: 11500000, guid: 3269ab77e5738674b9fefab358f453ff, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UIAnimLab.Station
  Code: 
  Title: Animation Sets
  Summary: "Demonstrations for the wiki page <b>Animation Sets</b>. One set of animations
    used by many players: Menu Buttons.asset in Assets/Showcase/Animation Sets.\n\nEach
    frame is 960 x 540 (16:9). In play mode the board starts focused on frame 1:
    Tab moves to the next, number keys jump, Home shows them all, H shows the index.
    With a frame focused, <b>Space</b> plays its demonstration, <b>R</b> puts it
    back and <b>L</b> loops it - set the Game view to 16:9 and the frame fills it
    exactly. \n\nSelect a frame to see in its Inspector what to capture and where
    it goes on the page. Assets/Showcase/SHOTLIST.md lists every shot."
  Watch: 
  WatchObjects: []
  HowTo: 
  Expect: 
  Needs: 0
  Style: 2
  WikiPage: 
  Capture: 
  Width: 960
  StageHeight: 0

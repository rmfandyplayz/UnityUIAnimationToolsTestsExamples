  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UIAnimLab.Station
  Code: P6
  Title: Chaining with On Complete
  Summary: One's On Complete plays Two, Two's plays Three. Spin Forever plays itself
    from its own On Complete.
  Watch: A, B, C
  WatchObjects:
  - {fileID: 119870828}
  - {fileID: 368643484}
  - {fileID: 597267308}
  HowTo: In play mode press One. Press One again and Stop All during B's punch. Press
    Spin Forever, then Stop All.
  Expect: 'A, B, C punch in turn. Stopped during B: C never punches (a stopped link
    doesn''t start the next). Spin Forever keeps turning in quarter turns until Stop
    All, then stops dead.'
  Needs: 2
  Style: 0
  WikiPage: 
  Capture: 
  Width: 620
  StageHeight: 260
